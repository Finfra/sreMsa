# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# sreMsa lab1 — 중첩(nested) 실습 환경
#
#   Windows 호스트
#   └── VirtualBox
#       └── i1  (이 Vagrantfile 이 만드는 VM 한 대)
#           ├── VirtualBox + Vagrant
#           └── VirtualBox VMs
#               ├── vm01  192.168.56.11
#               ├── vm02  192.168.56.12
#               └── vm03  192.168.56.13
#
# 이웃 폴더(vm_x_4)는 호스트가 VM 4대를 직접 만든다. 이 폴더는
# **VM 한 대만** 만들고 나머지를 그 안에서 만든다. 수강생에게 VM 하나만
# 배포하면 되는 것이 이 방식의 이유다.
#
# 안쪽 구조는 상위 폴더와 완전히 같다 — 노드명·IP·계정·inventory 가 동일하므로
# lab2 이후의 실습 명령을 한 글자도 바꾸지 않고 쓸 수 있다.
#
# ⚠️ 전제: 호스트 CPU 가 중첩 가상화를 지원해야 한다.
#    jpc1(i7-6700T) 실측에서 게스트가 `Virtualization: VT-x` 와 /dev/kvm 을
#    확보하는 것을 확인했다. 지원하지 않는 호스트에서는 상위 폴더를 쓴다.

require "yaml"
require "fileutils"

BASE = File.dirname(__FILE__)
S    = YAML.load_file(File.join(BASE, "settings.yml"))

OUTER = S["outer"]
INNER = S["inner"]

# 안쪽 노드의 /etc/hosts 블록을 미리 만들어 둔다.
# 바깥 VM 이 이 파일을 읽어 안쪽 Vagrantfile 에 넘긴다.
NET       = INNER["subnet"]
I1_IP     = "#{NET}.#{INNER['i1_host']}"
NODE_BASE = INNER["node_host_base"]
COUNT     = INNER["count"]

hosts_lines = ["#{I1_IP} i1"]
(1..COUNT).each { |i| hosts_lines << "#{NET}.#{NODE_BASE + i} #{format('vm%02d', i)}" }

# ⚠️ 바이너리 모드로 쓴다. Windows 의 Ruby 기본 텍스트 모드는 \n 을 \r\n 으로
# 바꾸고, 그러면 게스트 셸이 이름을 "vm01\r" 로 읽어 전부 어긋난다.
# 상위 폴더에서 실제로 겪은 문제다.
File.open(File.join(BASE, "inner", "hosts.generated"), "wb") do |f|
  f.write(hosts_lines.join("\n") + "\n")
end

Vagrant.configure("2") do |config|
  config.vm.box = S["box"]["name"]
  config.vm.box_version = S["box"]["version"] if S["box"]["version"]
  config.vm.box_check_update = (S["box"]["check_update"] == true)
  config.vm.boot_timeout = S["boot_timeout"] || 900
  config.vbguest.auto_update = false if Vagrant.has_plugin?("vagrant-vbguest")

  # 강의 소스 전체를 올린다. 안쪽 Vagrantfile 도 이 경로로 닿는다.
  config.vm.synced_folder "../../../", "/sreMsa"

  # 강사 배포 폴더(_prgs)가 소스 옆에 있으면 함께 올린다.
  # 안쪽 VirtualBox 도 box 가 필요한데, 이것이 있으면 621MB 를 다시 받지 않는다.
  # 없으면 조용히 건너뛴다 — 인터넷에서 받는 경로로 폴백한다.
  PRGS = File.expand_path("../../../../_prgs", BASE)
  config.vm.synced_folder PRGS, "/prgs" if Dir.exist?(PRGS)

  config.vm.define "i1", primary: true do |n|
    n.vm.hostname = "i1"
    n.vm.network "private_network", ip: OUTER["host_ip"]

    n.vm.provider "virtualbox" do |vb|
      vb.name   = "sreMsa-inVm"
      vb.cpus   = OUTER["cpu"]
      vb.memory = OUTER["memory"]

      # ★ 이 한 줄이 이 방식의 전부다. 게스트에 VT-x 를 넘겨 준다.
      #   없으면 안쪽 VirtualBox 가 "VT-x is not available" 로 기동에 실패한다.
      vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]

      # 중첩은 페이징 부하가 크다. 켜 두지 않으면 눈에 띄게 느려진다.
      vb.customize ["modifyvm", :id, "--nested-paging", "on"]
      vb.customize ["modifyvm", :id, "--paravirt-provider", "kvm"]

      # ★ Host I/O cache — 중첩에서는 이것이 성능을 좌우한다 (2026-08-31 실측).
      #   VirtualBox 의 SATA 컨트롤러는 기본이 off 라 게스트의 fsync 를 호스트
      #   디스크까지 그대로 밀어낸다. 단일 VM 이면 안전한 기본값이지만, 중첩은
      #   그 비용을 두 번 낸다(안쪽 게스트 → 바깥 파일 → 바깥 vdi → SSD).
      #
      #   실측(바깥 VM, 4k x200 oflag=dsync):
      #     off → 2.55~2.64초 (fsync 회당 12.8~13.2ms)
      #     on  → 0.217~0.243초 (회당 1.08~1.22ms)   = 약 11배
      #
      #   etcd 는 모든 쓰기를 fsync 하며 권장치가 10ms 미만이다. off 상태에서는
      #   이를 넘겨 apiserver·scheduler 가 재시작 루프에 빠지고 cluster.yml 이
      #   2시간 19분 만에 failed=1 로 끝났다.
      #
      #   ⚠️ 맞바꾸는 것: 호스트 전원이 갑자기 끊기면 캐시에 있던 쓰기가 유실된다.
      #      실습 환경이라 재구축이 가능하므로 감수한다.
      vb.customize ["storagectl", :id, "--name", "SATA Controller", "--hostiocache", "on"]

      # ── SSD 로 인식시킨다 (2026-09-06 실측) ──────────────────────────
      #   기본값이 nonrotational=off 라 게스트가 이 디스크를 회전 디스크로
      #   본다. 실측: /sys/block/sda/queue/rotational = 1,
      #             scheduler = none [mq-deadline]  ← SSD 인데 seek 최적화
      #   그 결과 커널이 있지도 않은 헤드 이동을 줄이려 요청을 병합·재정렬해
      #   지연을 스스로 만들고, readahead 도 과다해진다.
      #   discard=off 면 TRIM 이 안 돼(lsblk -D 의 DISC-MAX = 0B) 쓰기 증폭도 생긴다.
      #   ⚠️ 중첩에서는 이 손해가 두 겹이다 — 안쪽이 잘못 만든 요청이
      #      바깥의 잘못된 스케줄러를 한 번 더 통과한다.
      vb.customize ["storageattach", :id, "--storagectl", "SATA Controller",
                    "--port", "0", "--device", "0",
                    "--nonrotational", "on", "--discard", "on"]
      # headless 운용이라 원격 데스크톱 서버가 불필요하다.
      vb.customize ["modifyvm", :id, "--vrde", "off"]
    end

    n.vm.provision "outer", type: "shell",
                   path: "scripts/outer.sh",
                   args: [
                     S["tools"]["virtualbox_pkg"].to_s,
                     S["tools"]["vagrant_from"].to_s,
                     S["tools"]["vagrant_deb_url"].to_s,
                     (OUTER["expand_lvm"] ? "yes" : "no")
                   ]
  end
end
